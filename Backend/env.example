# --- Reader agent mode ---
# mock = simulator (random reads, no hardware needed)
# real = talk to actual RFID hardware
READER_MODE=real

# ============================================================
# DESKTOP ENROLLMENT SCANNER (RFG-WD01) — file registration
# ============================================================
# local = manual/mock entry, production = live desktop scanner hardware
DESKTOPSCANNER=production

# ============================================================
# DOOR / GATE ANTENNA READER — in/out movement detection
# ============================================================
# Simple single-reader config (what you want right now, with 1 antenna).
# For 2+ readers (once the 2nd door's hardware arrives), use RFID_READERS
# below instead and delete/ignore these.

READER_ID=reader-1
READER_GATE_ID=SHELF_ROOM_DOOR
# COURT_ROOM_DOOR is the other valid value once that door's reader is wired up.

# serial = USB/RS232 cable, tcp = LAN connection to the reader's IP
READER_TRANSPORT=serial

# --- used when READER_TRANSPORT=serial ---
# Windows: e.g. COM5   |   Linux/Mac: e.g. /dev/ttyUSB0
READER_PORT=COM5
READER_BAUD=57600

# --- used when READER_TRANSPORT=tcp ---
READER_HOST=192.168.1.190
READER_TCP_PORT=4001

# Antenna number -> direction for THIS gate (JSON object as a string).
# With only 1 antenna connected, map it to whichever side you're testing:
READER_ANTENNA_MAP={"1":"OUT"}

# How long (ms) to keep collecting EPCs into one batch before sending it to
# the dashboard. 1500ms is a reasonable start for a person walking through
# a doorway with a stack of files.
READER_BATCH_WINDOW_MS=1500

# ------------------------------------------------------------
# Multi-reader config (use once you have 2 doors wired up).
# Overrides everything in the READER_* block above if set.
# ------------------------------------------------------------
# RFID_READERS=[
#   {"id":"shelf-reader","gateId":"SHELF_ROOM_DOOR","transport":"tcp","host":"192.168.1.190","port":4001,"antennaMap":{"1":"OUT","2":"IN"}},
#   {"id":"court-reader","gateId":"COURT_ROOM_DOOR","transport":"serial","path":"COM6","baudRate":57600,"antennaMap":{"1":"IN","2":"OUT"}}
# ]
