# Server Configuration
PORT=4000
MONGODB_URI=mongodb://localhost:27017/rfid-tracker
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=rfid-tracking-secret-key-allahabad-high-court-2026
JWT_EXPIRES_IN=12h
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_STAFF_PASSWORD=Staff@123

# Reader Mode: mock | real
READER_MODE=real
READER_PRESENCE_TIMEOUT_MS=5000

# 2-Reader Network Setup (Shelf Room Door & Court Room Door)
RFID_READERS=[{"id":"shelf-door-reader","gateId":"SHELF_ROOM_DOOR","transport":"tcp","host":"192.168.2.116","port":49152,"antennaMap":{"1":"IN"}},{"id":"court-door-reader","gateId":"COURT_ROOM_DOOR","transport":"tcp","host":"192.168.2.101","port":49152,"antennaMap":{"1":"IN"}}]

# Desktop Scanner Integration: local | production
DESKTOPSCANNER=local

# ============================================================
# CASE TYPES & CAUSE LIST
# ============================================================
# Case types always shown in the Case Type dropdowns (comma separated).
# Types found in real files / cause lists are added automatically.
CASE_TYPES=WTAX,BAIL

# Optional: live Cause List API. Leave empty to sync by uploading a
# .csv / .xlsx / .json file from the Cause List page instead.
# The API must accept ?date=YYYY-MM-DD and return a JSON array (or {entries:[...]})
