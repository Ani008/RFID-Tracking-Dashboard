-    if (caseType !== undefined && typeof caseType !== 'string') {
-      return res.status(400).json({ error: 'caseType must be a string' });
-    }
-    if (court !== undefined && typeof court !== 'string') {
-      return res.status(400).json({ error: 'court must be a string' });
-    }
-
